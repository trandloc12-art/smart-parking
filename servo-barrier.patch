 const uint8_t LCD_ADDRS[] = {0x27, 0x3F};
+// Servo thanh chắn: mỗi cổng một servo. Góc 0..180 độ; chỉnh cho khớp cơ cấu thật (đảo hai góc nếu quay ngược).
