+def test_gate_env_priority_and_missing_gate_file(tmp_path):
+    (tmp_path / ".env").write_text("RFID_PORT=COM1\n", encoding="utf-8")
+    env, has_file = config.gate_env("out", str(tmp_path), environ={})
