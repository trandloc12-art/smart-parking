# CẤU HÌNH CHUNG cho cả hai cổng. Copy file này thành .env rồi sửa. KHÔNG commit file .env (có mật khẩu).
# Cổng COM và camera là RIÊNG từng cổng: xem .env.in.example và .env.out.example.

DB_SERVER=localhost\SQLEXPRESS # cần chỉnh sửa
DB_NAME=BienSoDB               # muốn đổi tên database thì đổi ở đây
DB_USER=                       # nhập sa hoặc user khác có quyền truy cập database (để trống = Windows Authentication)
DB_PASSWORD=                   # nhập mật khẩu của user ở trên
DB_DRIVER=ODBC Driver 17 for SQL Server

RFID_BAUD=9600
RFID_DEBOUNCE=2.0              # giây, bỏ qua quẹt trùng cùng một thẻ

AUTO_SAVE=1                    # cổng vào: 1 = chốt được 5 số thì tự lưu, 0 = luôn chờ nhân viên xác nhận
PRICE_PER_BLOCK=5000
BLOCK_MINUTES=60

# Quét nhiều ảnh sau mỗi lần quẹt thẻ, bỏ phiếu lấy 5 số trùng nhiều nhất
SCAN_FRAMES=5                  # số ảnh quét
SCAN_INTERVAL=0.25             # giây giữa hai ảnh
VOTE_MIN=2                     # số phiếu tối thiểu để tự chấp nhận

# Kích thước khung camera (mỗi cổng ~900px rộng; hai cổng cạnh nhau vừa màn hình 1920, màn nhỏ hơn sẽ tự thu nhỏ)
VIEW_W=420
VIEW_H=315
