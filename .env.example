CAMERA_INDEX=0

RFID_PORT=COM3                 #đổi cổng port trùng với cổng kết nối của thiết bị đọc thẻ RFID
RFID_BAUD=9600
RFID_DEBOUNCE=2.0

DB_SERVER=localhost\SQLEXPRESS #cần chỉnh sửa
DB_NAME=BienSoDB               # muốn đổi tên database thì đổi ở đây
DB_USER=                       # nhập sa hoặc user khác có quyền truy cập database
DB_PASSWORD=                   # nhập mật khẩu của user ở trên
DB_DRIVER=ODBC Driver 17 for SQL Server

AUTO_SAVE=1
PRICE_PER_BLOCK=5000
BLOCK_MINUTES=60