# CẤU HÌNH CHUNG cho cả hai cổng. Copy file này thành .env rồi sửa. KHÔNG commit file .env (có mật khẩu).
# Camera là RIÊNG từng cổng: xem .env.in.example và .env.out.example.

DB_SERVER=localhost\SQLEXPRESS # cần chỉnh sửa
DB_NAME=BienSoDB               # muốn đổi tên database thì đổi ở đây
DB_USER=                       # nhập sa hoặc user khác có quyền truy cập database (để trống = Windows Authentication)
DB_PASSWORD=                   # nhập mật khẩu của user ở trên
DB_DRIVER=ODBC Driver 17 for SQL Server

# MỘT Arduino (một cổng COM) nối cả hai đầu đọc RFID. Xem cổng COM: Device Manager, hoặc python -m serial.tools.list_ports
RFID_PORT=COM3
RFID_BAUD=9600
RFID_HEARTBEAT_TIMEOUT=8       # giây không nhận được gì từ Arduino thì báo "không phản hồi" (0 = không kiểm tra)
RFID_DEBOUNCE=2.0              # giây, bỏ qua quẹt trùng cùng một thẻ

PARKING_CAPACITY=3             # số slot (chỗ đỗ xe) của bãi. LCD hiển thị số slot còn trống; đủ slot thì cổng vào không nhận quẹt thẻ
AUTO_SAVE=1                    # cổng vào: 1 = chốt được 5 số thì tự lưu, 0 = luôn chờ nhân viên xác nhận
PRICE_PER_BLOCK=5000
BLOCK_MINUTES=60

# Quét nhiều ảnh sau mỗi lần quẹt thẻ, bỏ phiếu lấy 5 số trùng nhiều nhất
SCAN_FRAMES=5                  # số ảnh quét
SCAN_INTERVAL=0.25             # giây giữa hai ảnh
VOTE_MIN=2                     # số phiếu tối thiểu để tự chấp nhận

# LCD: sau khi xong việc (xe vào/ra OK, thẻ bị từ chối) tự về "MOI QUET THE" sau số giây này (0 = giữ đến lần quẹt sau)
LCD_IDLE_SECONDS=5

# Servo thanh chắn (mỗi cổng một servo, gắn vào cùng Arduino): quẹt thẻ thành công -> mở, tự đóng lại sau số giây này
SERVO_ENABLED=1                # 0 = chưa gắn servo thì tắt đi
SERVO_OPEN_SECONDS=3           # giây giữ thanh chắn mở (0.5..30)
SERVO_CLOSED_ANGLE=0           # góc ban đầu = thanh chắn hạ (0..180 độ). Gửi cho Arduino mỗi lần nó khởi động
SERVO_OPEN_ANGLE=90            # góc thanh chắn nâng (0..180 độ); servo quay ngược thì đảo hai giá trị. Hai cổng khác nhau: đặt riêng trong .env.in / .env.out

# Cảm biến hồng ngoại (mỗi cổng 2 cái, trước + sau thanh chắn): quẹt thẻ xong, xe phải đi qua thanh chắn thì phiên mới được LƯU;
# xe không đi qua thì phiên quẹt thẻ bị HỦY (không lưu thẻ, biển số, ảnh... gì cả). Xe qua rồi thì thanh chắn hạ ngay.
IR_ENABLED=1                   # 0 = chưa gắn cảm biến thì tắt đi (lưu ngay khi quẹt thẻ, không chờ xe đi qua)
IR_PASS_TIMEOUT_SECONDS=3      # giây: cảm biến TRƯỚC mất tín hiệu quá ngần này mà cảm biến SAU chưa thấy xe thì hủy phiên (xe rời đi); trước còn tín hiệu thì không hủy (0.5..30)

# Kích thước khung camera (mỗi cổng ~900px rộng; hai cổng cạnh nhau vừa màn hình 1920, màn nhỏ hơn sẽ tự thu nhỏ)
VIEW_W=420
VIEW_H=315
