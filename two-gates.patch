+        raise ValueError(f"Cổng phải là một trong {sorted(GATES)}, không phải '{gate}'")
+    g = GATES[gate]
+    s = Settings(
+        gate=gate,
+        label=g["label"],
+        camera_index=int(_env("CAMERA_INDEX", str(g["camera_index"]))),
+        rfid_port=_env("RFID_PORT", g["rfid_port"]),
