+             for n in ("PassDetector", "PassWindow", "CloseCountdown")]
+    d = tmp_path_factory.mktemp("barrier")
+    (d / "main.cpp").write_text(BARRIER_DRIVER % (*parts, hold, window), encoding="utf-8")
