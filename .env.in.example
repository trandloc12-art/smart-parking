# RIÊNG CỔNG VÀO. Copy thành .env.in rồi sửa.
RFID_PORT=COM3                 # đổi cho trùng cổng COM của đầu đọc RFID (Device Manager, hoặc: python -m serial.tools.list_ports)
CAMERA_INDEX=0
WINDOW_POS=+0+0                # (tuỳ chọn) chỉ dùng khi chạy riêng từng cổng: vị trí cửa sổ. Chế độ một cửa sổ bỏ qua
