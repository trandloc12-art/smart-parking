   Serial.begin(BAUD_RATE);
   SPI.begin();
   readerIn.PCD_Init();
   readerOut.PCD_Init();
+  initLcds();
   Serial.println(F("# dual_rfid san sang"));
   sendStatus();
   lastStatus = millis();
 }
 
 void loop() {
+  readSerialCommands();
   pollReader(readerIn, inOk, F("IN"));
   pollReader(readerOut, outOk, F("OUT"));
 
